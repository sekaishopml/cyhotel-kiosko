<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/modalBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <LinearLayout
        android:id="@+id/modalCard"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_modal_card"
        android:padding="24dp"
        android:gravity="center">

        <View
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_check_circle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="-40dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvModalTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Reserva confirmada!"
            android:textColor="#143A2A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvModalRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#10281D"
            android:textSize="15sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvModalCheckIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#10281D"
            android:textSize="15sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvModalCheckOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#10281D"
            android:textSize="15sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvModalAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#143A2A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnModalClose"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Cerrar"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_primary" />

    </LinearLayout>
</FrameLayout>
