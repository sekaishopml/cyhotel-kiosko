# Variables de entorno para el despliegue del hotel (copiar a .env y ajustar).
# El archivo .env NO se sube a git (está en .gitignore).

# Contraseña de la base de datos PostgreSQL (obligatoria para docker compose).
CYHOTEL_DB_PASSWORD=cambia_este_valor_seguro

# Respaldos offsite: destino rsync (opcional). Ej: usuario@vps:/var/backups/cyhotel-offsite
# Dejar vacío para omitir la copia offsite.
CYHOTEL_OFFSITE=

# Retención de respaldos locales (días).
CYHOTEL_BACKUP_RETENTION=7

# Monitoreo: URL de healthcheck (opcional, def: http://localhost:8000/api/health).
CYHOTEL_HEALTH_URL=http://localhost:8000/api/health

# Webhook de alertas (opcional): recibe POST {"text": "..."} (Telegram/Slack/etc.).
# Ej: https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<ID>  (usar formato adecuado)
CYHOTEL_ALERT_WEBHOOK=
