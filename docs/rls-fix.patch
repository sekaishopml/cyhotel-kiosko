diff --git a/backend/server.py b/backend/server.py
--- a/backend/server.py
+++ b/backend/server.py
@@ -22,15 +22,16 @@ DATABASE_URL = os.environ.get(
     "DATABASE_URL", "postgresql://cyhotel_app:cyhotel_app@localhost:5432/cyhotel"
 )
